[GLOBAL]
CLOUDLOC = [REMOTEDRIVE]
HOSTINGURL = [SITE]
EXTRACTLOC = $app_directory\bin\$ITEMNAME
SOURCEHOST = https://github.com/oldtools
ALTHOST = https://github.com/
EXHOST = https://github.com/fortuneAccount
Version = [VERSION]
UPDATEFILE = $SOURCEHOST/anattaGen/releases/download/portable/portable.zip
STEAMJSON1 = https://raw.githubusercontent.com/fortuneAccount/steam.json/refs/heads/main/steam.json
STEAMJSON2 = https://raw.githubusercontent.com/fortuneAccount/fortuneAccount/refs/heads/main/steam.json
STEAMIDB = https://store.steampowered.com/api/appdetails?appids=
PC_GWB = https://pcgamingwiki.com
PCGWB = https://www.pcgamingwiki.com
PCGWURL = https://www.pcgamingwiki.com/wiki/
PCGWAPI = https://www.pcgamingwiki.com/api/appid.php?appid=
STEAMDBI = https://steamdb.info/app/

# Format: url|extract_dir|exe_name|flags
# Flags (optional 4th field):
#   INSTALLER - Extracted file is an installer that must be run
#   INSTALLER:path/to/installed.exe - Installer with specific installed exe path
#   SILENT - Run installer silently (use with INSTALLER)
#   PORTABLE - Portable executable (default, no installation needed)


