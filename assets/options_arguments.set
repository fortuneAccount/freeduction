; ==============================================================================
; Options & Arguments Defaults
; ==============================================================================
; Section names correspond to internal config variables.
; Pipe-delimited values populate comboboxes in the right-click modal.
; The parser also maps these to config_keys via SECTION_TO_CONFIG_KEY.
; ==============================================================================

; ── Controller Mapper ────────────────────────────────────────────────────────

[controllermapperoptions]
options = --tray --hidden
arguments =

; ── Profiles ─────────────────────────────────────────────────────────────────

[player1profileoptions]
options = --tray --hidden --profile-controller 1 --profile
arguments =

[player2profileoptions]
options = --tray --hidden --profile-controller 2 --profile
arguments =

[deskprofileoptions]
options = --tray --hidden --profile-controller 0 --profile
arguments =

; ── Display ──────────────────────────────────────────────────────────────────

[monitorappoptions]
options = /loadconfig
arguments =

[monitorgamecfgoptions]
options = /loadconfig
arguments =

[monitordeskcfgoptions]
options = /loadconfig
arguments =

; ── Windowing ────────────────────────────────────────────────────────────────

[borderlessgamingoptions]
options =
arguments =

[unbordercfgoptions]
options =
arguments =

[rebordercfgoptions]
options =
arguments =

