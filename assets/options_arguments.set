; ==============================================================================
; Options & Arguments Defaults
; ==============================================================================
; Section names correspond to internal config variables.
; Pipe-delimited values populate comboboxes in the right-click modal.
; The parser also maps these to config_keys via SECTION_TO_CONFIG_KEY.
;
; FORMAT:
;   [section]       MUST be the canonical section referenced by
;                   constants.SECTION_TO_CONFIG_KEY (Python) and by
;                   get_options_section_for_key() (C config editor).
;   options =       pipe-delimited preset options. A LEADING '|' marks a
;                   "no option" empty-priority default. When queried via the
;                   launcher, the FIRST EFFECTIVE (non-empty) token is used;
;                   if the string begins with '|', the resolved value is empty.
;   arguments =     same semantics for preset arguments.
;
; The launcher observes absent (empty) elements when building launcher
; parameters, i.e. an empty option/argument is omitted from the command.
;
; Example:
;   [someapp]
;   options = |--vvv|--debug|^>^>NUL 2^>&1|--help
;   (empty-priority: the default option is empty; the dropdown offers the rest)
;
; NOTE: The <exe>options / <exe>arguments Application sections below are kept
; as ALIASES so the Python exe-basename lookup path also resolves. The
; canonical sections referenced by SECTION_TO_CONFIG_KEY are the ones above
; each alias group.
; ==============================================================================

; ── Controller Mapper ────────────────────────────────────────────────────────

[controllermapper]
options = |--tray --hidden --profile-controller 1 --profile|
arguments = --profile-controller ${P#} --profile

; ── Display ──────────────────────────────────────────────────────────────────

[monitorapp]
options = |/loadconfig|/internal|/extend|/clone|/external|
arguments =

