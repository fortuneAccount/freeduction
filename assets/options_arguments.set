[multimonitortool]
options =" /loadconfig "
arguments = " >NUL 2&>1"

[MONITOR_DESK_CFG]
options = " /loadconfig "\"${monitordeskcfg}\""
arguments = " >NUL 2&>1"

[MONITOR_GAME_CFG]
options = " /loadconfig "\"${monitorgamecfg}\""
arguments = " >NUL 2&>1"

[antimicrox]
options = " --tray --hidden --profile-controller ${P#} --profile "
arguments = " >NUL 2&>1"

[Player1_Profile]
options = " --tray --hidden --profile-controller 1 --profile \"${player1profile}\""
arguments = " >NUL 2&>1"

[Player2_Profile]
options = " --tray --hidden --profile-controller 2 --profile \"${player2profile}\""
arguments = " >NUL 2&>1"

[Player${P#}_Profile]
options = " --tray --hidden --profile-controller ${P#} --profile \"${player${P#}profile}\""
arguments = " >NUL 2&>1"

[DESK_PROFILE]
options = " --tray --hidden --profile-controller ${P#} --profile \"${deskprofile}\""
arguments = " >NUL 2&>1"

