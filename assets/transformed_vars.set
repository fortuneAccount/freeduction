[GLOBALVARS]
$GAME_TITLE = $SAFE_GAME_NAME
$PLAYER_P# = $PLAYER_{$PLAYER_NUMBER}
$PLAYER# = ${P#}
$MONITOR# = ${M#}
$APP_DIR = $APP_ROOT_DIR
$GAME_PROFILE = $PROFILEDIRECTORY
$INSTALL_DIR = $GAME_DIRECTORY
$EXE_NAME = $GAME_EXECUTABLE
$GAME_DIRECTORY = $game_install_path
$STEAM_ID = $STEAM_ID
$GOGDB_ID = $GOGDB_ID
$INC = ((${VAR})+1)
$STEAM_LOCATION = %STEAMPATH% | ~/.steam/steam | ~/Library/Application Support/Steam | /data/data/com.valvesoftware.android.steam.community
$UBISOFT_INSTALL = $ubisoft_install_path
$USER_NAME = %USERNAME% | $USER | $USER | $USER
$USER_PROFILE = %USERPROFILE% | $HOME | $HOME | /data/data/<package_name>
$HOME = %USERPROFILE% | $HOME | $HOME | /data/data/<package_name> 
$USER_DOCUMENTS = %USERPROFILE%\Documents | ~/Documents | ~/Documents | /storage/emulated/0/Documents
$WINDIR = %WINDIR%
$ALLUSERSPROFILE = %PROFILESFOLDER%\Public
$LOCAL_LOW = %LOCALAPPDATA%Low | ~/.local/share | ~/Library/Application Support | /data/data/<package_name>/files
$APP_DATA = %APPDATA% | ~/.config | ~/Library/Application Support | /data/data/<package_name>/shared_prefs
$LOCAL_APPDATA = %LOCALAPPDATA% | ~/.local/share | ~/Library/Application Support | /data/data/<package_name>/files
$PROGRAM_FILES = %PROGRAMFILES% | /usr/local | /Applications | /data/app
$PROGRAM_FILES32 = %PROGRAMFILES(X86)% | /usr/lib32 | N/A (universal binaries) | N/A
$COMPUTERNAME = %COMPUTERNAME% | $HOSTNAME | $HOSTNAME
$PROGRAM_DATA = %PROGRAMDATA% | /usr/share | /Library/Application Support | /data
$PUBLIC_PROFILE = %PUBLIC% | /usr/share | /Users/Shared | /storage/emulated/0
$PUBLIC = %PUBLIC% | /usr/share | /Users/Shared | /storage/emulated/0
$SYSTEM_ROOT = %WINDIR% | / | /System | /system
$HKEY_PREFS = HKEY_CURRENT_USER | ~/.config | ~/Library/Preferences | /data/data/<package_name>/shared_prefs
$HKEY_LOCAL = HKEY_LOCAL_MACHINE | /etc | /Library/Preferences | /system
$HKEY_MULTIARCH = HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node | /etc (multiarch paths like /usr/lib32) | N/A | N/A
$TEMP_DIR = %LOCALAPPDATA%\temp | var/tmp | $TMPDIR | getCacheDir()
$TEMP = %LOCALAPPDATA%\temp | var/tmp | $TMPDIR | getCacheDir()
$TMP = %LOCALAPPDATA%\temp | var/tmp | $TMPDIR | getCacheDir()

$MONITOR${M#}_NAME = "\\.\DISPLAY${M#}"
$MONITOR${M#}_RESXx$MONITOR${M#}_RESY = $MONITOR${M#}_NAME_{$resolution}
$MONITOR${M#}_FREQ = $MONITOR${M#}_NAME_{$frequency}
$MONITOR${M#}_DEPTH = $MONITOR${M#}_NAME_{$bitdepth}
$MONITOR${M#}_POSX = $MONITOR${M#}_NAME_{$position_x}
$MONITOR${M#}_POSY = $MONITOR${M#}_NAME_{$position_y}
$MONITOR${M#}_ORIENT = $MONITOR${M#}_NAME_{$orientation}
$MONITOR${M#}_PRIMARY = $MONITOR${M#}_NAME_{$primary}